# Copie este arquivo para .env e defina a senha do painel admin.
ADMIN_PASSWORD=
# Porta do servidor (padrão 3000)
PORT=3000
# Pasta onde ficam config.json e os vídeos enviados (padrão ./data)
DATA_DIR=./data
# Tamanho máximo de cada vídeo em MB (padrão 500)
MAX_VIDEO_MB=500
# Use 1 quando o site estiver atrás de um proxy/hospedagem (Render, Railway, Nginx)
TRUST_PROXY=0
