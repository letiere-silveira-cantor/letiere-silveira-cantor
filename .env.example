# Copie este arquivo para .env (uso local) ou cadastre estas variáveis na Vercel.

# Senha do painel admin (obrigatória)
ADMIN_PASSWORD=

# Opcional: chave para assinar o login. Se vazio, é derivada da senha.
SESSION_SECRET=

# --- Vercel ---
# Preenchidas automaticamente ao conectar o Upstash Redis (Storage > Marketplace) ao projeto:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Preenchida automaticamente ao criar um Vercel Blob (Storage > Blob):
# BLOB_READ_WRITE_TOKEN=

# --- Servidor próprio / local ---
PORT=3000
# Pasta onde ficam os dados e vídeos (padrão ./data)
DATA_DIR=./data
# Use 1 atrás de um proxy (Nginx, Render, Railway). Na Vercel é automático.
TRUST_PROXY=0

# Tamanho máximo de cada vídeo em MB (padrão 500)
MAX_VIDEO_MB=500
